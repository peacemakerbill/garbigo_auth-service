# Garbigo auth-service - environment variable template.
# Copy this file to .env and fill in real values for your machine:
#   cp .env.example .env
# .env itself must never be committed - see .gitignore.

# --- MongoDB / Redis / RabbitMQ ---
MONGODB_URI=mongodb://localhost:27017/garbigo_auth
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_USER_CREATED=user-created-queue

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT ---
# Generate a fresh, random secret per environment - never reuse one across
# dev/staging/prod, and never reuse the one that used to live in application.yml.
JWT_SECRET=
JWT_EXPIRATION=2592000

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# --- App / server ---
SERVER_PORT=8080
APP_URL=http://localhost:3000

# --- Social login (leave blank to disable a provider locally) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
