# Garbigo auth-service - local environment variables.
#
# Loaded automatically at startup via application.yml's:
#   spring.config.import: optional:file:.env[.properties]
# This is a native Spring Boot feature (since 2.4) - the [.properties] hint
# tells Spring Boot to parse this file's KEY=VALUE lines as Java properties,
# regardless of the .env extension. No extra library dependency needed.
#
# This file holds REAL values for local development.
# Do NOT commit it - add ".env" to .gitignore and keep only .env.example
# checked into source control.
#
# IMPORTANT: every secret below has already been pasted into chat/uploaded
# files earlier in this project's history, so it must be treated as already
# compromised regardless of where it now lives. Rotate the Gmail app
# password, the Cloudinary API secret, and the JWT signing secret before any
# of this reaches a real environment - moving them into this file does not
# undo that exposure.

# --- MongoDB / Redis / RabbitMQ ---
MONGODB_URI=mongodb://localhost:27017/garbigo_auth
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_USER_CREATED=user-created-queue

# --- Mail (SMTP) ---
# No quotes around the password: this file is parsed as Java .properties,
# where everything after "=" (including spaces) is taken literally.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=thepeacemakerske@gmail.com
MAIL_PASSWORD=mjyk cibp uids weiy

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=thepeacemakersllc
CLOUDINARY_API_KEY=279386562332176
CLOUDINARY_API_SECRET=_UVXMFDd78NXrqPrIQA-JJK_u98

# --- JWT ---
JWT_SECRET=pR5q9T8wX2z7C4v3B6nM1kLj8HgFdEaSbQcW3eZr4tY7uKiOp9L0mN2bV5cX8jH
JWT_EXPIRATION=2592000

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# --- App / server ---
SERVER_PORT=8080
APP_URL=http://localhost:3000

# --- Social login ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
